# Server
PORT=50051
STORAGE_DRIVER=postgres

# Storage (required when STORAGE_DRIVER=postgres)
DATABASE_URL=postgres://user:password@localhost:5432/orchestrator?sslmode=disable

# Storage (required when STORAGE_DRIVER=redis)
REDIS_ADDR=localhost:6379

# Control-plane default scope metadata
TENANT_ID=default
NAMESPACE_ID=default

# Valid STORAGE_DRIVER values:
# - postgres (recommended)
# - redis
# - memory
